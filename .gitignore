__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.DS_Store
*.gguf
.env

# Exported ONNX graphs are large build artifacts, regenerated by
# `python -m visionflow.onnx_export --export`. The *reports* about them
# (benchmarks/results/) are committed; the weights are not.
benchmarks/onnx/
*.onnx

# Materialized dataset images (hundreds of MB), rebuilt deterministically with
# `vf dataset <source> -n <n> --seed <seed>`. The labeled_set.json manifests
# next to them ARE committed, so a run is reproducible without the blobs.
benchmarks/datasets/*/images/
