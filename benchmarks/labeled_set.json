{
  "_about": "Labeled evaluation set for VisionFlow. Ground truth is the literal text rendered into each synthetic sample image by examples/generate_sample_images.py, so labels are exact by construction rather than human-annotated. Every value is fabricated: no real patient, shipment, or company data appears here. This set is small (3 images, 20 fields) and is intended to make quantization-level differences visible, not to establish absolute accuracy — for that, see the DocVQA/ChartQA note in the README.",
  "samples": [
    {
      "id": "medical_report",
      "image": "examples/sample_images/medical_report.png",
      "category": "medical document",
      "prompt": "Extract the patient data, procedure details, and diagnosis code from this surgical report.",
      "schema": {
        "patient_name": "string",
        "mrn": "string",
        "dob": "string (YYYY-MM-DD)",
        "date_of_surgery": "string (YYYY-MM-DD)",
        "surgeon": "string",
        "procedure": "string",
        "diagnosis_code": "string",
        "asa_class": "string",
        "estimated_blood_loss": "string",
        "operative_time": "string"
      },
      "ground_truth": {
        "patient_name": "Jordan A. Rivera (SYNTHETIC)",
        "mrn": "SYN-00417293",
        "dob": "1978-03-14",
        "date_of_surgery": "2026-06-02",
        "surgeon": "Dr. L. Whitfield, MD",
        "procedure": "Laparoscopic cholecystectomy",
        "diagnosis_code": "K80.20 — Cholelithiasis without obstruction",
        "asa_class": "II",
